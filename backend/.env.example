# ============================================================
#  DB Quest AI — backend configuration
#  Copy this file to ".env" (same folder) and fill in values.
#  EVERYTHING below is optional: with no .env at all the app runs
#  fully offline — SQLite auto-created, demo team seeded, mock AI,
#  TF-IDF search. Set values here to unlock more.
# ============================================================

# ---- AI provider: mock | openai | azure | gemini | groq ----
# "mock" (default) = offline deterministic brain, no key needed.
# openai/azure also switch document search to embeddings; gemini/groq keep TF-IDF.
AI_PROVIDER=mock

# OpenAI (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (AI_PROVIDER=azure)
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_API_VERSION=2024-02-01

# Google Gemini (AI_PROVIDER=gemini) — chat only; search stays on TF-IDF
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (AI_PROVIDER=groq) — free, OpenAI-compatible; chat only, search stays on TF-IDF
# Get a free key (no card required) at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Auth ----
# Change this to a long random string in production. Controls JWT signing.
JWT_SECRET=dev-secret-change-me-in-production
# Token lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ----
# Default: local SQLite file at backend/storage/dbquest.db (auto-created).
# On Vercel the default SQLite file goes to /tmp, which is EPHEMERAL and per-instance:
# uploads/generated missions won't survive cold starts. For durable persistence set a
# managed Postgres here (Vercel Postgres, Neon, Supabase, RDS, ...):
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbquest
DATABASE_URL=

# ---- Behaviour ----
# Seed a demo team + demo users + sample content on first run (recommended for demos).
SEED_DEMO=true

# ---- Web / CORS ----
# In production the frontend and API share one origin (the app calls the relative
# "/api" path), so CORS is not needed. The current Vercel deployment URL is auto-allowed.
# Set this only for a separately hosted frontend; use "*" to allow any origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
