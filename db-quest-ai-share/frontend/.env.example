# ============================================================
#  DB Quest AI — frontend configuration (Vite)
#  Copy to ".env" for local overrides. All values are OPTIONAL.
# ============================================================

# Base URL for the backend API.
# Leave UNSET for the normal deployment, where the API is served same-origin
# under "/api" (this is how Vercel serves it — no config needed).
# Set this ONLY if the backend lives on a different origin, and include the
# "/api" path segment, e.g.:
#   VITE_API_URL=https://my-api.example.com/api
# VITE_API_URL=
