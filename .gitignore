# ============================================================
#  DB Quest AI — root .gitignore
# ============================================================

# ---- Secrets & local config (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python / FastAPI backend ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Local database & uploaded/generated storage ----
backend/storage/
*.db
*.sqlite
*.sqlite3

# ---- Node / Vite / React frontend ----
node_modules/
frontend/dist/
dist/
build/
.vite/
*.local

# ---- Logs & temp ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
